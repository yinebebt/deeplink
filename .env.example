DEEPLINK_LISTEN_ADDR=:8090
DEEPLINK_BASE_URL=http://localhost:8090
DEEPLINK_REDIS_ADDR=localhost:6379
DEEPLINK_REDIS_PASSWORD=
# Comma-separated origins allowed to call the JSON API from a browser.
# Add the dashboard origin here when running it on a different host/port.
# Dev example: http://localhost:5173
DEEPLINK_ALLOWED_ORIGINS=
DEEPLINK_TEMPLATE_DIR=
DEEPLINK_SKIP_PATHS_FILE=
DEEPLINK_CLICK_BUFFER_SIZE=1024
DEEPLINK_CLICK_FLUSH_INTERVAL=1s
DEEPLINK_API_KEY=

# Set any of these to enable /redirect and /preview/ routes.
# DEEPLINK_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.app
# DEEPLINK_IOS_STORE_URL=https://apps.apple.com/us/app/example-app/id1234567890
# DEEPLINK_WEB_FALLBACK_URL=https://example.com

# Preview metadata defaults emitted on every preview page.
# DEEPLINK_SITE_NAME=Example
# DEEPLINK_LOCALE=en_US
# DEEPLINK_TWITTER_SITE=@example
# DEEPLINK_FEDIVERSE_CREATOR=@user@instance.tld

# web/ dashboard (Vite)
# The SPA reads this from the same root .env (envDir is set to repo root
# in web/vite.config.ts). VITE_API_URL is the Go service URL
#    Scheme is required for prod builds; add http://localhost:5173 to
#    DEEPLINK_ALLOWED_ORIGINS above if dev + cross-origin testing.
VITE_API_URL=http://localhost:8091
